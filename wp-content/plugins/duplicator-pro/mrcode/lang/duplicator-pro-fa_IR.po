#: template/admin_pages/settings/general/usage_tracking_tooltip.php:36
msgid ""
"Below is the list of information that Duplicator collects as part of the usage "
"tracking:"
msgstr ""
"در زیر لیستی از اطلاعاتی که داپلیکیتور به عنوان بخشی از ردیابی استفاده جمع آوری "
"می کند، آمده است:"

#: template/admin_pages/settings/general/usage_tracking_tooltip.php:43
#, php-format
msgid ""
"%1$sPHP Version:%2$s So we know which PHP versions we have to test against (no "
"one likes whitescreens or log files full of errors)."
msgstr ""
"%1$sPHP نسخه:%2$s بنابراین ما می دانیم که باید در برابر کدام نسخه های PHP آزمایش "
"کنیم (هیچ کس صفحه سفید یا فایل های لاگ پر از خطا را دوست ندارد)."

#: template/admin_pages/settings/general/usage_tracking_tooltip.php:56
#, php-format
msgid ""
"%1$sWordPress Version:%2$s So we know which WordPress versions to support and "
"test against."
msgstr ""
"%1$sنسخه وردپرس:%2$s بنابراین ما می دانیم که کدام نسخه وردپرس را پشتیبانی کرده و "
"با آن آزمایش کنیم."

#: template/admin_pages/settings/general/usage_tracking_tooltip.php:69
#, php-format
msgid ""
"%1$sMySQL Version:%2$s So we know which versions of MySQL to support and test "
"against for our custom tables."
msgstr ""
"%1$sMySQL نسخه:%2$s بنابراین ما می دانیم که کدام نسخه از MySQL را برای جداول "
"سفارشی خود پشتیبانی و آزمایش کنیم."

#: template/admin_pages/settings/general/usage_tracking_tooltip.php:82
#, php-format
msgid ""
"%1$sDuplicator Version:%2$s So we know which versions of Duplicator are "
"potentially responsible for issues when we get bug reports, \n"
"                allowing us to identify issues and release solutions much faster."
msgstr ""
"%1$sنسخه Duplicator:%2$s بنابراین می‌دانیم که کدام نسخه‌های Duplicator به طور "
"بالقوه مسئول مشکلاتی هستند که گزارش‌های اشکال دریافت می‌کنیم،\n"
" به ما این امکان را می دهد که مشکلات را شناسایی کرده و راه حل ها را خیلی سریعتر "
"منتشر کنیم."

#: template/admin_pages/settings/general/usage_tracking_tooltip.php:96
#, php-format
msgid ""
"%1$sPlugins and Themes infos:%2$s So we can figure out which ones can generate "
"compatibility errors with Duplicator."
msgstr ""
